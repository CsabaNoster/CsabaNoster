---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('art', (e: CollectionEntry<'art'>) => e.data.published !== false);
  return entries.map((entry: CollectionEntry<'art'>) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'art'> };
const { Content } = await entry.render();
---
{/* Fixed-position navigation arrows for art detail page (dummy links for now) */}
<div class="window-nav-arrow-fixed-center window-nav-arrow-fixed-center--left">
  <a class="steam-btn" href="/art/prev" title="Previous art" aria-label="Previous art">
    <span class="steam-btn__plate"><span class="nav-arrow-icon">&#8592;</span></span>
  </a>
</div>
<div class="window-nav-arrow-fixed-center window-nav-arrow-fixed-center--right">
  <a class="steam-btn" href="/art/next" title="Next art" aria-label="Next art">
    <span class="steam-btn__plate"><span class="nav-arrow-icon">&#8594;</span></span>
  </a>
</div>
---
// Find previous and next art slugs
import { getCollection, getEntryBySlug, type CollectionEntry } from 'astro:content';
const { slug } = Astro.params as { slug: string };
const entry = await getEntryBySlug('art', slug) as CollectionEntry<'art'> | undefined;
if (!entry) {
  throw new Error(`Art not found: ${slug}`);
}
const { Content } = await entry.render();
const allArt = await getCollection('art', (e: CollectionEntry<'art'>) => e.data.published !== false);
allArt.sort((a: CollectionEntry<'art'>, b: CollectionEntry<'art'>) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime());
const currentIndex = allArt.findIndex(e => e.slug === slug);
const prevSlug = currentIndex > 0 ? allArt[currentIndex - 1].slug : null;
const nextSlug = currentIndex < allArt.length - 1 ? allArt[currentIndex + 1].slug : null;
---
{/* Fixed-position navigation arrows for art detail page (real previous/next links) */}
{prevSlug && (
  <div class="window-nav-arrow-fixed-center window-nav-arrow-fixed-center--left">
    <a class="steam-btn" href={`/art/${prevSlug}/`} title="Previous art" aria-label="Previous art">
      <span class="steam-btn__plate"><span class="nav-arrow-icon">&#8592;</span></span>
    </a>
  </div>
)}
{nextSlug && (
  <div class="window-nav-arrow-fixed-center window-nav-arrow-fixed-center--right">
    <a class="steam-btn" href={`/art/${nextSlug}/`} title="Next art" aria-label="Next art">
      <span class="steam-btn__plate"><span class="nav-arrow-icon">&#8594;</span></span>
    </a>
  </div>
)}
<BaseLayout title={entry.data.title} description={entry.data.summary ?? 'Art detail'}>
  <article class="prose prose-neutral dark:prose-invert max-w-none">
    <h1 class="!mt-0">{entry.data.title}</h1>
    {(entry.data as any).image && <img src={(entry.data as any).image} alt={entry.data.title} class="rounded mb-6" />}
    <Content />
  </article>
</BaseLayout>
